
# ============================================
# R-MOVE - Git ignore rules
# ============================================

# Datos originales (siempre ignorados)
/data/raw/**
!/data/raw/**/
!/data/raw/**/.gitkeep

# Datos procesados (ignorados por defecto)
/data/processed/**
!/data/processed/**/
!/data/processed/**/.gitkeep

# Excepciones: resultados del dashboard R-MOVE
!/data/processed/rmove/incidencia_2025_06_05.json
!/data/processed/rmove/incidencia_2025_02_07.json
!/data/processed/rmove/incidencia_2025_03_17.json
!/data/processed/rmove/incidencia_2023_05_02.json
!/data/processed/rmove/incidencia_2024_04_29.json
!/data/processed/rmove/general/dashboard_general.json

# Entornos virtuales
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Jupyter Notebooks
.ipynb_checkpoints/
*.nbconvert.ipynb

# Credenciales y configuración privada
.env
.env.*
!.env.example
.streamlit/secrets.toml
*.pem
*.key

# Sistema operativo y editores
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs y archivos temporales
*.log
*.tmp
*.temp

# Resultados generados
/outputs/figures/**
!/outputs/figures/**/
!/outputs/figures/**/.gitkeep
/outputs/tables/**
!/outputs/tables/**/
!/outputs/tables/**/.gitkeep
